# ---------------------------------------------------------------
# Cherry Embed SDK — Example environment variables
#
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# Get APP_ID (your embed ID) and APP_SECRET from https://portal.cherry.fun:
#   your Project -> Chat embeds -> your embed's settings
#
# All examples (app-trusted, app-trusted+wallet, wallet-only) read this
# single root .env file via dotenv.
#
# Both naming conventions are supported (short or CHERRY_-prefixed):
#   APP_ID    or  CHERRY_APP_ID
#   APP_SECRET or CHERRY_APP_SECRET
#   ROOM_ID   or  CHERRY_ROOM_ID
# ---------------------------------------------------------------

# Your Cherry application ID (public, safe to expose in client JS)
APP_ID=

# Your Cherry application secret — KEEP PRIVATE, server-side only.
# Used to sign HS256 embedTokens in the app-trusted and app-trusted+wallet
# examples. wallet-only does NOT need this.
APP_SECRET=

# Optional per-mode overrides. Useful when you keep separate Cherry embeds
# for each authMode while sharing this single .env file.
# APP_TRUSTED_ID / APP_TRUSTED_SECRET require an embed whose auth mode is set
# to `app-trusted` at portal.cherry.fun (self-serve — pick it yourself).
APP_TRUSTED_ID=
APP_TRUSTED_SECRET=
APP_WALLET_ID=
APP_WALLET_SECRET=
APP_WALLETLESS_ID=

# Optional: default room to open when the embed loads.
# If empty, the embed opens with no preselected room.
ROOM_ID=

# Cherry embed iframe URL.
# Production: https://embed.cherry.fun
# Local dev (with messaging-server running): http://localhost:3002
CHERRY_EMBED_URL=https://embed.cherry.fun

# Port for example Express servers (both examples use this)
PORT=3000

# Host interface the example servers bind to.
# Default 127.0.0.1 (loopback) — the examples mint embedTokens with your real
# APP_SECRET and have no auth of their own, so they must not be reachable from
# the network. Only set 0.0.0.0 if you know exactly who can reach the port.
# HOST=127.0.0.1

# ---------------------------------------------------------------
# !! DEMO / TEST ONLY — NEVER SET THIS IN A REAL BACKEND !!
#
# Enables POST /api/session/switch in the app-trusted example, which lets
# ANY caller choose which wallet the server signs an embedToken for. It
# exists so you can test a specific wallet's room access, rate limits, or
# moderation role without logging in as them.
#
# This is the "client picks the identity" hole the example's own comments
# warn about. Deliberately left OFF here: copying this template must never
# enable it, because `cp .env.example .env` is a documented step and the
# HOST override below can put the route on the network. When unset, the
# route does not exist at all (404) and the example still works with its
# default demo session.
#
# Turn it on per run, never in .env:
#   DEMO_SESSION_SWITCH=true npm run start:app-trusted
# ---------------------------------------------------------------
# DEMO_SESSION_SWITCH=true
