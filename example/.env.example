# Get these from Cherry Admin Panel -> Embed -> Register App
CHERRY_APP_ID=your-app-id
CHERRY_APP_SECRET=your-app-secret

# Room to embed (public room ID from Cherry)
CHERRY_ROOM_ID=your-public-room-id

# Cherry API URL (for development)
CHERRY_API_URL=http://localhost:3000

# Cherry Embed URL (where the embed iframe loads from)
# Now a separate Vite app on its own domain/port
CHERRY_EMBED_URL=http://localhost:3002

# Port for this example server
PORT=8080
