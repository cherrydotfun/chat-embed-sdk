{
  "name": "@cherrydotfun/chat-embed-sdk",
  "version": "0.1.6",
  "description": "Embed Cherry Chat public rooms into any website. Wallet-based auth, full theming, lightweight iframe-based.",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cherry",
    "chat",
    "embed",
    "widget",
    "iframe",
    "solana",
    "web3",
    "messaging"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cherrydotfun/chat-embed-sdk.git"
  },
  "homepage": "https://portal.cherry.fun",
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^29.1.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  }
}
